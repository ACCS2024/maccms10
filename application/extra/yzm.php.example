return [
    // 转码服务源站，用于让图床回源抓图；留空则跳过抓图步骤
    'transcoder_url' => 'http://transcoder.example.com:2100',

    // 图床域名：vod_pic 最终指向这里
    'pic_domain'     => 'http://pic.example.com',

    // 图床的回源抓取接口，参数值会被 rawurlencode 后追加；留空则不调用
    'pic_fetch_api'     => 'http://pic.example.com/remote.php?pic_url=',
    'pic_fetch_timeout' => 15,

    // 播放域名：拼 m3u8 与 share 地址
    'play_domain' => 'https://play.example.com',

    // 播放器标识（写入 vod_play_from）与剧集名
    'player_flag' => 'example_m3u8',
    'play_name'   => '第1集',

    // m3u8 = 只入库 m3u8 地址；all = m3u8 与分享地址都入库
    'addr_mode' => 'm3u8',

    // 新入库记录的初始状态：0=待审核 1=已发布
    'default_status' => 0,

    // 转码机 category → mac_type.type_id 映射，按自己站点的栏目填
    'category_map' => [
        // 'example_category' => 1,
    ],

    // 标题黑名单：命中任一即拒绝入库
    'keyword_blacklist' => [],
