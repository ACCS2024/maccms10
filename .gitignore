# 安装锁:每个部署在安装时生成,不应入库(否则全新克隆会误判「已安装」)
application/data/install/install.lock
# 后台安全schema更新锁(运行时生成)
application/data/update/sec_schema.lock
# 本地冒烟用的后台入口副本(绕过 admin.php 改名防护;不入库)
adm_smoke.php

.claude/settings.local.json


# 运行时产物,不入库:
#   data/backup/*.sql   —— db:export / 后台备份导出的库转储(含站点数据)
#   data/optimize/      —— php think tune 生成的主机调优配置(基础设施信息)
# 目录里的 index.html 占位文件仍然跟踪。
application/data/backup/*.sql
application/data/optimize/
application/data/asset_version.txt

# 每站独有的运行时配置(站名/域名/主题/图床/各类密钥),不入库。
# 仓库只保留中性样板 application/data/config/maccms.example.php;
# config/maccms.php 会在真实文件缺失时按「runtime 影子备份 → 样板」自动播种。
# 历史教训:这个文件曾被 track,里面存的是冒烟机的值,乐播新机部署后主题变 vozy、
# site_url 指着 216.180.225.139、图床指向 img.test.com,全站封面 404。
application/extra/maccms.php
